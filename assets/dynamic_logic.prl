%-------------------------------------------
% @formula: dl_orR
% @theory: dynamic_logic
% @pvsfile: dynamic_logic.pvs
% @status: ✅ proved
%-------------------------------------------
dl_orR : PROOF
(then (SKEEP)(SKEEP)
  (spread (SPLIT)
   ((then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE -2)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE 2)(EXPAND "dlSequent")(SKEEP)(INST?)
     (spread (SPLIT -2)
      ((then (SKEEP)
        (spread (CASE "j=0")
         ((spread (INST 1 "0")
           ((then (EXPAND "nth" -2)(ASSERT)(EXPAND "nth" 1 1)(EXPAND "DLOR" 1)(PROPAX))
            (then (EXPAND "length" 1 1)(ASSERT))))
          (spread (CASE "j=1")
           ((spread (INST 2 "0")
             ((then (EXPAND "nth")(EXPAND "nth")(EXPAND "DLOR")(ASSERT))
              (then (EXPAND "length" 1 1)(ASSERT))))
            (spread (INST 3 "j-1")
             ((then (EXPAND "nth" 3 1)(ASSERT)(EXPAND "nth" -1)(EXPAND "nth" -1)(PROPAX))
              (then (ASSERT)(EXPAND "length" 1 1)(TYPEPRED "j")(EXPAND "length" -1)(EXPAND "length" -1)(ASSERT)))))))))
       (then (PROPAX)))))
    (then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE -2)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE 2)(EXPAND "dlSequent")(SKEEP)(INST?)
     (spread (SPLIT -2)
      ((then (SKEEP)(EXPAND "nth" -1)
        (spread (SPLIT -1)
         ((then (FLATTEN)(EXPAND "DLOR")
           (spread (SPLIT)
            ((spread (INST 1 "0")
              ((then (EXPAND "nth")(PROPAX))
               (then (EXPAND "length")(EXPAND "length")(ASSERT))))
             (spread (INST 1 "1")
              ((then (EXPAND "nth" 1)(EXPAND "nth" 1)(PROPAX))
               (then (EXPAND "length")(EXPAND "length")(ASSERT)))))))
          (then (FLATTEN)(TYPEPRED "j")(EXPAND "length" -1)
           (spread (INST 2 "j+1")
            ((then (EXPAND "nth" 2)(EXPAND "nth" 2)(ASSERT))
             (then (EXPAND "length" 1)(EXPAND "length" 1)(ASSERT))))))))
       (then (PROPAX))))))))
QED dl_orR


%-------------------------------------------
% @formula: dl_impliesR
% @theory: dynamic_logic
% @pvsfile: dynamic_logic.pvs
% @status: ✅ proved
%-------------------------------------------
dl_impliesR : PROOF
(then (SKEEP)(SKEEP)
  (spread (SPLIT)
   ((then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE -2)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(EXPAND "dlSequent")(SKEEP)(INST -2 "env")(ASSERT)
     (spread (CASE "NOT P(env)")
      ((spread (INST 2 "0")
        ((then (EXPAND "nth" 2)(ASSERT)(EXPAND "DLIMPLIES" 2 1)(PROPAX))
         (then (EXPAND "length" 1 1)(ASSERT))))
       (spread (SPLIT -3)
        ((then (ASSERT)(SKEEP)
          (spread (CASE "j=0")
           ((spread (INST 1 "0")
             ((then (EXPAND "nth" 1 1)(ASSERT)(EXPAND "DLIMPLIES" 1 1)(EXPAND "nth" -2)(PROPAX))
              (then (EXPAND "length" 1 1)(ASSERT))))
            (spread (INST 2 "j")
             ((then (EXPAND "nth")(ASSERT))
              (then (EXPAND "length" 1)(TYPEPRED "j")(EXPAND "length" -1)(PROPAX)))))))
         (then (ASSERT)(SKEEP)
          (spread (CASE "i=0")
           ((then (EXPAND "nth")(ASSERT))
            (spread (INST -2 "i-1")
             ((then (EXPAND "nth" 2)(ASSERT))
              (then (ASSERT)(TYPEPRED "i")(EXPAND "length" -1)(ASSERT))))))))))))
    (then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(FLATTEN)
     (spread (SPLIT)
      ((spread (SPLIT)
        ((then (ASSERT)(HIDE -3)(HIDE -1)(USE "dlSequent_equiv")(ASSERT)(EXPAND "dlSequent")(SKEEP)(INST -2 "env")
          (spread (SPLIT)
           ((then (ASSERT)(HIDE 2)(SKEEP)
             (spread (CASE "j=0")
              ((spread (INST 1 "j")
                ((then (EXPAND "nth" (-2 1))(ASSERT)(EXPAND "DLIMPLIES")
                  (spread (INST?)
                   ((then (EXPAND "nth")(PROPAX))
                    (then (TYPEPRED "j")(EXPAND "length")(ASSERT)))))
                 (then (TYPEPRED "j")(EXPAND "length")(PROPAX))))
               (then (EXPAND "nth" -1)(ASSERT)
                (spread (INST 2 "j")
                 ((then (EXPAND "nth" (-1 2))
                   (spread (SPLIT)
                    ((then (FLATTEN)(EXPAND "nth" 2)(ASSERT))
                     (then (ASSERT)))))
                  (then (TYPEPRED "j")(EXPAND "length")(PROPAX))))))))
            (then (SKEEP)(TYPEPRED "i")
             (spread (INST -2 "i+1")
              ((then (EXPAND "nth" -2)(PROPAX))
               (then (EXPAND "length" 1)(ASSERT))))))))
         (then (PROPAX))))
       (then (PROPAX))))))))
QED dl_impliesR
