%-------------------------------------------
% @formula: dl_orR
% @theory: dynamic_logic
% @pvsfile: dynamic_logic.pvs
% @status: ✅ proved
%-------------------------------------------
dl_orR : PROOF
(then (SKEEP)(SKEEP)
  (spread (SPLIT)
   ((then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE -2)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE 2)(EXPAND "dlSequent")(SKEEP)(INST?)
     (spread (SPLIT -2)
      ((then (SKEEP)
        (spread (CASE "j=0")
         ((spread (INST 1 "0")
           ((then (EXPAND "nth" -2)(ASSERT)(EXPAND "nth" 1 1)(EXPAND "DLOR" 1)(PROPAX))
            (then (EXPAND "length" 1 1)(ASSERT))))
          (spread (CASE "j=1")
           ((spread (INST 2 "0")
             ((then (EXPAND "nth")(EXPAND "nth")(EXPAND "DLOR" 2)(ASSERT))
              (then (EXPAND "length" 1 1)(ASSERT))))
            (spread (INST 3 "j-1")
             ((then (EXPAND "nth" 3 1)(ASSERT)(EXPAND "nth" -1)(EXPAND "nth" -1)(PROPAX))
              (then (ASSERT)(EXPAND "length" 1 1)(TYPEPRED "j")(EXPAND "length" -1)(EXPAND "length" -1)(ASSERT)))))))))
       (then (PROPAX)))))
    (then (FLATTEN)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE -2)(LEMMA "dlSequent_equiv")(INST?)(ASSERT)(HIDE 2)(EXPAND "dlSequent")(SKEEP)(INST?)
     (spread (SPLIT -2)
      ((then (SKEEP)(EXPAND "nth" -1)
        (spread (SPLIT -1)
         ((then (FLATTEN)(EXPAND "DLOR")
           (spread (SPLIT)
            ((spread (INST 1 "0")
              ((then (EXPAND "nth")(PROPAX))
               (then (EXPAND "length")(EXPAND "length")(ASSERT))))
             (spread (INST 1 "1")
              ((then (EXPAND "nth" 1)(EXPAND "nth" 1)(PROPAX))
               (then (EXPAND "length")(EXPAND "length")(ASSERT)))))))
          (then (FLATTEN)(TYPEPRED "j")(EXPAND "length" -1)
           (spread (INST 2 "j+1")
            ((then (EXPAND "nth" 2)(EXPAND "nth" 2)(ASSERT))
             (then (EXPAND "length" 1)(EXPAND "length" 1)(ASSERT))))))))
       (then (PROPAX))))))))
QED dl_orR
