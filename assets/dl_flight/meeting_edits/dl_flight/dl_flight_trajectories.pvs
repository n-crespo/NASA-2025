% @date: Mon, 09 Jun 2025 17:21:22 GMT
%%
dl_flight_trajectories [(IMPORTING dL@top) T, x, y, vx, vy : dLVar]: THEORY
  BEGIN

    ASSUMING
       list_of_correct_var : list[dLVar] = (: T, x, y, vx, vy :)

       distinct_vars : ASSUMPTION
         pairwise_distinct_vars?(list_of_correct_var)

    ENDASSUMING

    IMPORTING trig@sincos

   % 1.) Define initial type & instruction type
      %valid_variables?(hp:HP) : RECURSIVE bool =
      %  CASES hp OF
      %	  xxx
      % 	ENDCASES

     %ValidHP : TYPE = (valid_variables?)

        % Valid structure of MAPEXPR that we care about
          valid_variables(a : Assigns) : bool =
            LET N = length(a) IN
              N = length(list_of_correct_var) IMPLIES
              FORALL (i: below(N)):
                nth( a, i )`1 = nth( list_of_correct_var, i )

        % Initial EX: ASSIGN(.....)
        initial?(hp : HP) : bool = assign?(hp) AND valid_variables(assigns(hp))

        initial : TYPE = (initial?)

        % Instruction EX: SEQ (DIFF(......), TEST(......))
        instruction?(hp : HP) : bool = seq?(hp) AND diff?(stm1(hp)) AND valid_variables(odes(stm1(hp))) AND test?(stm2(hp))

        instruction : TYPE = (instruction?)

        is_list_instruction(l : list[HP]) : RECURSIVE bool =
          CASES l OF
            null : TRUE,
            cons(h, t) : instruction?(h) AND is_list_instruction(t)
          ENDCASES
          MEASURE length(l)

        % Valid flight instructions
        valid_instructions : TYPE = {h : list[instruction] | length(h) > 0}

        % Flight structure as an input
        % flight_structure : TYPE = [initial, valid_instructions]

        %Instruction structure for how the plan should move for long
        is_instruction(h : HP) : RECURSIVE bool = seq?(h) AND instruction?(stm1(h)) AND ((instruction?(stm2(h)) OR is_instruction(stm2(h)))) MEASURE size(h)



        flight_list_structure : TYPE = {l : list[HP] | length(l) > 1 AND initial?(car(l)) AND is_list_instruction(cdr(l))}


        %Initializes the starting point of the plan and has instructions for a flight plan
        flight : TYPE = {h : HP | (seq?(h) AND initial?(stm1(h)) AND is_instruction(stm2(h)) )}


   % 2.) Define initial, linear, accel, turn which returns one of the types above
        initial(xp, yp, vX, vY : real) : HP = ASSIGN((: T << cnst(0), x << cnst(xp), y << cnst(yp), vx << cnst(vX), vy << cnst(vY):))

        linear(t : real) : HP =  SEQ(DIFF((: T << cnst(1), x << val(vx), y << val(vy), vx << cnst(0), vy << cnst(0) :)), TEST(val(T) = cnst(t)))

        accel(a, t : real) : HP = SEQ(DIFF((: T << cnst(1), x << val(vx), y << val(vy), vx << cnst(a), vy << cnst(a) :)), TEST(val(T) = cnst(t)))


        turn(theta, t: real) : HP = SEQ(DIFF((: T << cnst(1), x << val(vx), y << val(vy), vx << cnst(cos(theta)) * val(x) - cnst(sin(theta))* val(y), vy << val(x) * cnst(sin(theta))+ val(y) * cnst(cos(theta)) :)), TEST(val(T) = cnst(t)))


   % 3.) Create a function taht return a valid flight (It is called flight right now)

        % simple_flight_helper(inst : valid_instructions) : RECURSIVE (is_instruction) =
        %   IF length(inst) = 1 THEN car(inst) ELSE SEQ(car(inst), simple_flight_helper(cdr(inst))) ENDIF
        %   MEASURE length(inst)

        % simple_flight(fp : flight_structure) : flight = SEQ(fp`1, simple_flight_helper(fp`2))

        simple_list_flight_recursive(i : valid_instructions) : RECURSIVE (is_instruction) =
          IF length(i) = 1 THEN car(i) ELSE SEQ(car(i), simple_list_flight_recursive(cdr(i))) ENDIF MEASURE(length(i))

        simple_list_flight(f : flight_list_structure) : flight =
          SEQ(car(f), simple_list_flight_recursive(cdr(f)))

   % 4.) What property do I want to specify about them

      %enclosure(....) : bool = ...

      %test: LEMMA
      %   (Gamma |- ALLRUNS(HP,enclosure) AND .... ) IMPLIES
      %   Gamma |- ALLRUNS(SEQ(HP,accel(...)),enclosure(...)


   % 5.)


   % NOTES FROM MEETING

   %turn_right (t) assume an angle or turn rate, and then go to that time

   %Turn function may already be in PVS find it

   %Turn left until 90* north, consider hhow to make this

   %Need to flip sign and cosine...?

   %ALLRUNS(Initial >>> LInear 10s >> ..., Radius)

   %THink about backwareds aviation library

   %Generate eutil trajectoriers? & simulate this kind of system in Kymeria

  % 1.5)


  END dl_flight_trajectories
