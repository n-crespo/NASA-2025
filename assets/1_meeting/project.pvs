project: THEORY
  BEGIN
    IMPORTING dL@top

    sx: dLVar = dlvar(0)
    sy: dLVar = dlvar(1)

    vx: dLVar = dlvar(2)
    vy: dLVar = dlvar(3)


    Init(sx0,sy0,vx0,vy0:real) : HP =
      ASSIGN((:
        sx << cnst(sx0),
        sy << cnst(sy0),
        vx << cnst(vx0),
        vy << cnst(vy0)
      :))
  END project
