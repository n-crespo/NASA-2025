%-------------------------------------------
path_accel : PROOF
(then (EXPAND "BoolExpr2seq")(SKEEP)(REWRITE "dlSequent_equiv")(REWRITE "dlSequent_equiv")(EXPAND "dlSequent")(SKOLEM 1 "env0")(INST -1 "env0")(FLATTEN)
  (spread (SPLIT)
   ((then (INST 1 "0")(SKEEP)
     (spread (CASE "j=0")
      ((then (EXPAND "nth" -2)(ASSERT)(HIDE -1)(HIDE -2)(EXPAND "nth" 1)(EXPAND "ALLRUNS")(SKOLEM 1 "envFinal")(FLATTEN)(EXPAND "semantic_rel" -2)(SKOLEM -2 "env1")(FLATTEN)(INST -1 "env1")(ASSERT)(EXPAND "DLAND")(FLATTEN)(REWRITE "dlSequent_equiv")(EXPAND "dlSequent")(INST -1 "env1")
        (spread (SPLIT)
         ((then (SKEEP)
           (spread (CASE "j!1=0")
