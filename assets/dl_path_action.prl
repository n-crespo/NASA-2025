%-------------------------------------------
% @formula: path_turn
% @theory: dl_path_action
% @pvsfile: dl_path_action.pvs
% @status: ❗ unfinished
%-------------------------------------------
path_turn : PROOF
(then (SKEEP)(BETA)(REWRITE "dlSequent_equiv")(REWRITE "dlSequent_equiv")(EXPAND "dlSequent")(SKOLEM 1 "env0")(FLATTEN)(INST 1 "0")(EXPAND "nth" 1)(INST -1 "env0")
  (spread (SPLIT)
   ((then (SKEEP)
     (spread (CASE "j=0")
      ((then (EXPAND "nth" -2)(ASSERT)(HIDE -1)(HIDE -2)(EXPAND "ALLRUNS")(SKOLEM 1 "envFinal")(FLATTEN)(EXPAND "semantic_rel" -2)(SKOLEM -2 "env1")(FLATTEN)(INST -1 "env1")
        (spread (SPLIT)
         ((then (FLATTEN)(HIDE -4)(EXPAND "turn")(EXPAND "semantic_rel" -4)(SKOLEM -4 "env2")(FLATTEN)(EXPAND "semantic_rel" -4)(FLATTEN)(UNROLL -4)(EXPAND "nth" -4)(EXPAND "nth" -4)(EXPAND "cnst" -4)(EXPAND "nth" -5)(EXPAND "cnst" -5)
           (spread (INST-CP -6 "dlvar_index(trk)")
            ((spread (INST-CP -6 "dlvar_index(gs)")
              ((spread (INST-CP -6 "dlvar_index(sx)")
                ((spread (INST-CP -6 "dlvar_index(sy)")
                  ((then (SKOLEM -15 "env3")(FLATTEN)(EXPAND "semantic_rel" -15)(EXPAND "semantic_rel" -15)
                    (spread (SPLIT)
                     ((then (FLATTEN)(REPLACE -2)))))))
                 (then (HIDE-ALL-BUT 1))))
               (then (HIDE-ALL-BUT 1))))
             (then (HIDE-ALL-BUT 1)))))
          (then (PROPAX)))))
       (then (HIDE-ALL-BUT 1)(TYPEPRED "j")(EXPAND "length" -1)(EXPAND "length" -1)(ASSERT)))))
    (then (PROPAX)))))
QED path_turn


