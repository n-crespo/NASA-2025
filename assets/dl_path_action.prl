                    (spread (SPLIT -15)
                     ((then (FLATTEN)(REPLACE -2)(REPLACE -18 :DIR RL)(EXPAND "val")
                       (spread (SPLIT -17)
                        ((then (FLATTEN)(ASSERT))
                         (then (FLATTEN)(ASSERT)))))
