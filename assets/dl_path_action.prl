  (spread (SPLIT)
   ((then (HIDE -2)(SKEEP)
     (spread (CASE "j=0")
      ((then (REPLACE -1)(HIDE -1)(EXPAND "nth")(EXPAND "DLAND")(EXPAND "enclosure")(EXPAND "enclosureRE")(EXPAND "cnst")(EXPAND "*")(EXPAND "+")(EXPAND "-")(EXPAND "tmin")(EXPAND "div_safe_re")(EXPAND "cnst")(EXPAND "^")(EXPAND "sin_re")(EXPAND "cos_re")(EXPAND "val")(EXPAND "-")(EXPAND "ALLRUNS")(SKOLEM 1 "envFinal")(FLATTEN)(EXPAND "semantic_rel" -2)(SKOLEM -2 "env1")(FLATTEN)(EXPAND "semantic_rel" -3)(EXPAND "accel")(SKOLEM -3 "env2")(FLATTEN)(EXPAND "semantic_rel" -4)(SKOLEM -4 "env3")(INST -1 "env1")(FLATTEN)
