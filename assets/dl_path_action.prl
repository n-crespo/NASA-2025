                       (spread (INST -2 "fs_accel(env2,a)" "D")
                        ((then (LEMMA "accel_sol")(INST? -1)(INST -1 "t" "D")(EXPAND "accel" -1)
                          (spread (ASSERT)
                           ((then (HIDE -2)(UNROLL -2)(INST -3 "r")(INST -4 "r")(INST -5 "r")(INST -6 "r")(UNROLL -8)(EXPAND "nth" -8)(EXPAND "nth" -8)(EXPAND "nth" -8)(EXPAND "nth" -8)(EXPAND "nth" -8)(EXPAND "nth" -9)(EXPAND "nth" -9)(EXPAND "nth" -9)(EXPAND "nth" -9)(EXPAND "nth" -10)(EXPAND "nth" -10)(EXPAND "nth" -10)(EXPAND "nth" -11)(EXPAND "nth" -11)(EXPAND "nth" -12)(REPLACE -9 :DIR RL)(REPLACE -10 :DIR RL)(REPLACE -11 :DIR RL)(REPLACE -12 :DIR RL)(HIDE -8 -9 -10 -11 -12)(REPLACE -3 :DIR RL)(REPLACE -4 :DIR RL)(REPLACE -5 :DIR RL)(REPLACE -6 :DIR RL)(HIDE -3 -4 -5 -6)(EXPAND "fs_accel" 1)(EXPAND "fs_accel" -19)(EXPAND "solution_odes?")(FLATTEN)(HIDE -1)
                             (spread (SPLIT -20)
                              ((then (FLATTEN)(ASSERT))
                               (then (FLATTEN)(REPLACE -20)(ASSERT)(REPLACE -1)(EXPAND "div_safe")(ASSERT)))))
                            (then (HIDE-ALL-BUT 1)(SKEEP)(INST 1 "x+1")(ASSERT)))))
                         (then (HIDE-ALL-BUT 1)(SKEEP))
                         (then (HIDE-ALL-BUT 1)(SKEEP)(EXPAND "length")(EXPAND "length")(EXPAND "length")(EXPAND "length")(EXPAND "length")(EXPAND "length")(PROPAX))))))))
                   (then (HIDE-ALL-BUT 1)(EXPAND "not_in_map")(SKEEP)(EXPAND "nth")(EXPAND "nth")(TYPEPRED "i")(EXPAND "length")(EXPAND "length")(EXPAND "length")(ASSERT)(HIDE -1)(LIFT-IF)(LEMMA "distinct_vars")(EXPAND "list_of_correct_var")(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "pairwise_distinct_vars?")(FLATTEN)(EXPAND "distinct_var?")(FLATTEN)(EXPAND "distinct_var?")(FLATTEN)(EXPAND "distinct_var?")(FLATTEN)(EXPAND "distinct_var?")(FLATTEN)(EXPAND "distinct_var?")(FLATTEN)(ASSERT))))
